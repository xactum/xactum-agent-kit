{
  "name": "@xactum/agent-kit",
  "version": "0.1.0",
  "description": "Two lines to let your agents check an LLM price or model against XACTUM, the neutral verification oracle (verifies, never routes, no referral fees).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./x402": {
      "types": "./dist/x402.d.ts",
      "import": "./dist/x402.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "typescript": "5.9.3",
    "viem": "2.57.13",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "x402",
    "ai-agents",
    "llm",
    "verification",
    "oracle",
    "price-check"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xactum/xactum-agent-kit.git"
  },
  "homepage": "https://api.xactum.com"
}
